---
import Layout from '../../layouts/Layout.astro';
import { translations } from '../../i18n/translations.js';

const lang = Astro.params.lang || 'es';
const t = translations[lang] || translations.es;
const API_URL = import.meta.env.API_URL || 'http://localhost:3001';
---
<Layout title="Inicio" lang={lang}>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content container">
      <div class="hero-badge">{t.hero.badge}</div>
      <h1 class="hero-title">
        Adrian
        <span class="highlight">Portilla</span>
      </h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>
      <div class="hero-buttons">
        <a href={`/${lang}/#gallery`} class="btn btn-primary">
          ◈ {t.hero.cta}
        </a>
        <a href={`/${lang}/contacto`} class="btn btn-outline">
          {t.hero.ctaContact} →
        </a>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="section container" id="about" style="text-align: center; max-width: 860px; margin: 0 auto;">
    <h2 class="section-title reveal" style="font-size: 2.5rem; margin-bottom: 1rem;">
      {t.about.title1}<span style="color: var(--accent);">{t.about.titleHighlight}</span>
    </h2>
    <div class="golden-line reveal delay-100" style="margin-bottom: 2.5rem;"></div>
    <p class="reveal delay-200" style="font-size: 1.15rem; line-height: 1.8; color: var(--text-secondary); margin-bottom: 1.5rem; text-align: justify; font-weight: 300;" set:html={t.about.p1}></p>
    <p class="reveal delay-300" style="font-size: 1.15rem; line-height: 1.8; color: var(--text-secondary); margin-bottom: 2.5rem; text-align: justify; font-weight: 300;" set:html={t.about.p2}></p>
    <div style="text-align: center;" class="reveal delay-300">
      <a href={`/${lang}/contacto`} class="btn btn-outline">
        {t.about.cta} →
      </a>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="section" id="gallery">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="section-title">{t.gallery.title}</h2>
        <div class="golden-line"></div>
        <p class="section-subtitle">{t.gallery.subtitle}</p>
      </div>

      <!-- Grid (9 per page) -->
      <div id="galleryGrid" class="gallery-grid">
        <p style="text-align:center; color:var(--text-muted); grid-column:1/-1; padding:3rem;">
          {t.gallery.loading}
        </p>
      </div>

      <!-- Pagination -->
      <div id="galleryPagination" class="gallery-pagination" style="display:none; margin-top:2.5rem;"></div>
    </div>
  </section>

  <!-- Store CTA -->
  <section style="padding:6rem 0; background:var(--bg-card); position:relative; overflow:hidden;">
    <div class="container" style="text-align:center; position:relative; z-index:2;">
      <div class="hero-badge reveal" style="margin-bottom:1rem;">{t.store.badge}</div>
      <h2 class="reveal delay-100" style="margin-bottom:1rem; color:var(--text-primary);">{t.store.title}</h2>
      <p class="reveal delay-200" style="color:var(--text-secondary); margin-bottom:2rem; max-width:560px; margin-left:auto; margin-right:auto;">{t.store.subtitle}</p>
      <div class="reveal delay-300">
        <a href={`/${lang}/tienda`} class="btn btn-primary">{t.store.viewStore} →</a>
      </div>
    </div>
  </section>

</Layout>

<script define:vars={{ API_URL, emptyMsg: t.gallery.empty }}>
  const PER_PAGE = 9;
  let allImages = [];
  let currentPage = 1;

  /* ── Render page ── */
  function renderPage(page) {
    currentPage = page;
    const start = (page - 1) * PER_PAGE;
    const pageImages = allImages.slice(start, start + PER_PAGE);
    const grid = document.getElementById('galleryGrid');

    grid.style.opacity = '0';
    grid.style.transform = 'translateY(12px)';

    setTimeout(() => {
      grid.innerHTML = pageImages.map(img => `
        <div class="gallery-item" onclick="window.openLightbox('${img.url}')">
          <img src="${img.url}" alt="Tattoo by Adrian Portilla" loading="lazy" />
          <div class="gallery-overlay"></div>
        </div>
      `).join('');

      grid.style.transition = 'opacity 0.32s ease, transform 0.32s ease';
      grid.style.opacity = '1';
      grid.style.transform = 'translateY(0)';
    }, 140);

    renderPagination();
    // Scroll gallery into view gently on page change
    if (page !== 1) {
      document.getElementById('gallery').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function renderPagination() {
    const totalPages = Math.ceil(allImages.length / PER_PAGE);
    const pag = document.getElementById('galleryPagination');

    if (totalPages <= 1) { pag.style.display = 'none'; return; }

    pag.style.display = 'flex';

    let html = `<button class="gallery-page-btn" onclick="renderPage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}>‹</button>`;

    for (let i = 1; i <= totalPages; i++) {
      if (i === 1 || i === totalPages || Math.abs(i - currentPage) <= 1) {
        html += `<button class="gallery-page-btn ${i === currentPage ? 'active' : ''}" onclick="renderPage(${i})">${i}</button>`;
      } else if (Math.abs(i - currentPage) === 2) {
        html += `<span style="color:var(--text-muted); display:flex; align-items:center; padding:0 0.3rem; font-size:0.85rem;">…</span>`;
      }
    }

    html += `<button class="gallery-page-btn" onclick="renderPage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}>›</button>`;
    pag.innerHTML = html;
  }

  /* ── Load ── */
  async function loadGallery() {
    const grid = document.getElementById('galleryGrid');
    try {
      const res = await fetch(`${API_URL}/api/gallery`);
      const data = await res.json();
      allImages = data.images || [];

      if (!allImages.length) {
        grid.innerHTML = `<p style="text-align:center; color:var(--text-muted); padding:3rem; grid-column:1/-1;">${emptyMsg}</p>`;
        return;
      }

      renderPage(1);
    } catch {
      grid.innerHTML = `<p style="text-align:center;color:var(--text-muted);padding:3rem;grid-column:1/-1;">Error al cargar galería.</p>`;
    }
  }

  loadGallery();
</script>
