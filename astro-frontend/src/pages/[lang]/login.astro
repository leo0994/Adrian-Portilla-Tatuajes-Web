---
import Layout from '../../layouts/Layout.astro';
import { translations } from '../../i18n/translations.js';

const lang = Astro.params.lang || 'es';
const t = translations[lang] || translations.es;
const API_URL = import.meta.env.API_URL || 'http://localhost:3001';
// Agrega PUBLIC_GOOGLE_CLIENT_ID en el .env de Astro
const GOOGLE_CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || 'TU_GOOGLE_CLIENT_ID_AQUI';
---
<Layout title={t.login.title} lang={lang}>
<section style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:2rem; background: var(--bg-primary);">
  <div style="background:var(--bg-elevated); border:1px solid var(--border); border-radius:24px; padding:3.5rem 3rem; max-width:440px; width:100%; box-shadow: var(--shadow); backdrop-filter: blur(20px);">
    <div style="text-align:center; margin-bottom:2.5rem;">
      <h1 id="pageTitle" style="font-family:'Cinzel',serif; font-size:2rem; letter-spacing: 0.05em; color:var(--text-primary);">{t.login.title}</h1>
      <p id="pageSubtitle" style="color:var(--text-secondary); font-size:1rem; margin-top:0.75rem;">{t.login.subtitle}</p>
    </div>

    <form id="loginForm">
      <div class="form-group">
        <label>{t.login.email}</label>
        <input type="email" id="email" placeholder="usuario@email.com" required />
      </div>
      <div class="form-group">
        <label>{t.login.password}</label>
        <div style="position:relative;">
          <input type="password" id="password" placeholder="••••••••" required style="width:100%; padding-right:40px;" />
          <button type="button" id="togglePasswordBtn" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--text-muted); cursor:pointer; padding:0; display:flex;">
            <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <svg id="eyeOffIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
          </button>
        </div>
      </div>
      <div id="loginError" style="display:none; color:var(--error); font-size:0.85rem; margin-bottom:1rem; text-align:center;"></div>
      <button type="submit" class="btn btn-primary" style="width:100%;" id="loginBtn">
        {t.login.button}
      </button>

      <div style="text-align:center; margin-top:1.5rem; font-size:0.85rem; color:var(--text-muted);">
        <span id="toggleText">{t.login.noAccount}</span> 
        <a href="#" id="toggleModeBtn" style="color:var(--accent); text-decoration:none; margin-left:0.5rem;">{t.login.signUp}</a>
      </div>
    </form>

    <div style="margin:2rem 0; display:flex; align-items:center; text-align:center; color:var(--text-muted); font-size:0.85rem;">
      <hr style="flex:1; border-color:var(--border-subtle);" />
      <span style="padding:0 1rem;">{t.login.or}</span>
      <hr style="flex:1; border-color:var(--border-subtle);" />
    </div>

    <div id="googleBtnContainer" style="display:flex; justify-content:center;"></div>
    
  </div>
</section>

<!-- Script para Google Identity Services -->
<script src="https://accounts.google.com/gsi/client" async defer></script>
</Layout>

<script define:vars={{ API_URL, lang, GOOGLE_CLIENT_ID, successTxt: t.login.success, successRegTxt: t.login.successReg, errorDefTxt: t.login.errorDefault, errorConnTxt: t.login.errorConnection, verifyingTxt: t.login.verifying, buttonTxt: t.login.button, titleTxt: t.login.title, subTxt: t.login.subtitle, regTitleTxt: t.login.registerTitle, regSubTxt: t.login.registerSub, regBtnTxt: t.login.registerBtn, hasAccountTxt: t.login.hasAccount, signInTxt: t.login.signIn, noAccountTxt: t.login.noAccount, signUpTxt: t.login.signUp }}>
  let isRegisterMode = false;

  window.handleGoogleCredential = async function(response) {
     try {
       const res = await fetch(`${API_URL}/api/auth/google`, {
         method: 'POST',
         headers: { 'Content-Type': 'application/json' },
         body: JSON.stringify({ credential: response.credential })
       });
       const data = await res.json();
       if (data.token) {
         localStorage.setItem('apt_user_token', data.token);
         window.showToast(successTxt, 'success');
         setTimeout(() => window.location.href = `/${lang}/tienda`, 1000); // Redirect to store
       } else {
         window.showToast(data.error || 'Error con Google Auth', 'error');
       }
     } catch(e) {
       window.showToast(errorConnTxt, 'error');
     }
  }

  window.onload = function () {
    if(window.google) {
      google.accounts.id.initialize({
        client_id: GOOGLE_CLIENT_ID,
        callback: window.handleGoogleCredential
      });
      google.accounts.id.renderButton(
        document.getElementById("googleBtnContainer"),
        { theme: "outline", size: "large", width: "100%" } 
      );
    }
  }

  document.getElementById('togglePasswordBtn').addEventListener('click', () => {
    const input = document.getElementById('password');
    const eye = document.getElementById('eyeIcon');
    const eyeOff = document.getElementById('eyeOffIcon');
    if (input.type === 'password') {
      input.type = 'text';
      eye.style.display = 'none';
      eyeOff.style.display = 'block';
    } else {
      input.type = 'password';
      eye.style.display = 'block';
      eyeOff.style.display = 'none';
    }
  });

  // Toggle between Login and Register modes
  document.getElementById('toggleModeBtn').addEventListener('click', (e) => {
    e.preventDefault();
    isRegisterMode = !isRegisterMode;
    document.getElementById('pageTitle').textContent = isRegisterMode ? regTitleTxt : titleTxt;
    document.getElementById('pageSubtitle').textContent = isRegisterMode ? regSubTxt : subTxt;
    document.getElementById('loginBtn').textContent = isRegisterMode ? regBtnTxt : buttonTxt;
    document.getElementById('toggleText').textContent = isRegisterMode ? hasAccountTxt : noAccountTxt;
    e.target.textContent = isRegisterMode ? signInTxt : signUpTxt;
    document.getElementById('loginError').style.display = 'none';
  });

  // Handle standard Email Form Process
  document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('loginBtn');
    const errEl = document.getElementById('loginError');
    btn.disabled = true;
    btn.textContent = verifyingTxt;
    errEl.style.display = 'none';

    try {
      const endpoint = isRegisterMode ? '/api/auth/register' : '/api/auth/login';
      const res = await fetch(`${API_URL}${endpoint}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: document.getElementById('email').value,
          password: document.getElementById('password').value
        })
      });
      const data = await res.json();
      if (data.token) {
        localStorage.setItem('apt_user_token', data.token);
        window.showToast(isRegisterMode ? successRegTxt : successTxt, 'success');
        setTimeout(() => window.location.href = `/${lang}/tienda`, 1000);
      } else {
        errEl.textContent = data.error || errorDefTxt;
        errEl.style.display = 'block';
      }
    } catch {
      errEl.textContent = errorConnTxt;
      errEl.style.display = 'block';
    } finally {
      btn.disabled = false;
      btn.textContent = isRegisterMode ? regBtnTxt : buttonTxt;
    }
  });
</script>
