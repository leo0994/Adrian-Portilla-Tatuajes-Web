generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./tattoo.db"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String?
  role       String?  @default("user")
  google_id  String?
  created_at DateTime @default(now())

  @@map("users")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  currency    String?  @default("USD")
  stock       Int?     @default(0)
  images      String?  @default("[]") // Store as JSON string in SQLite
  active      Boolean? @default(true)
  created_at  DateTime @default(now())

  @@map("products")
}

model GalleryImage {
  id         Int      @id @default(autoincrement())
  url        String
  public_id  String?  
  title      String?
  active     Boolean  @default(true)
  created_at DateTime @default(now())

  @@map("gallery_images")
}
